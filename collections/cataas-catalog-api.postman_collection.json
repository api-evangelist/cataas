          "name": "CATAAS List Cats in the Catalog",
          "request": {
            "name": "CATAAS List Cats in the Catalog",
            "description": {
              "content": "Returns an array of cat documents. Filter by tags and paginate using `skip` and `limit`. Use this endpoint to discover ids consumable by `/cat/{id}`.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "cats"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "tags",
                  "value": "<string>",
                  "description": "Comma-separated list of tags to filter on. Returns only cats that carry at least one of the given tags."
                },
                {
                  "disabled": false,
                  "key": "skip",
                  "value": "<integer>",
                  "description": "Number of records to skip for pagination."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<integer>",
                  "description": "Maximum number of records to return."
                }
              ],
              "variable": []
