    "_postman_id": "d15a52cf-fbff-475f-95d7-3e16877df686",
    "name": "Cataas Admin Catalog API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "CATAAS (Cat as a Service) is a free, no-authentication REST API that returns random cat images and GIFs with optional tags, filters, sizing, and text overlays. It is an open-source project published under the GitHub cataas organization (https://github.com/cataas/cataas) and is consumed primarily as image URLs that can be embedded directly into HTML, README files, and chat applications.\n\nContact Support:\n Name: CATAAS Project",
      "type": "text/plain"
    }
