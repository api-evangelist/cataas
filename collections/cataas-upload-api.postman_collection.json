                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "formdata",
                  "formdata": [
                    {
                      "description": {
                        "content": "Comma-separated list of tags to apply to the new cat.",
                        "type": "text/plain"
                      },
                      "key": "tags",
                      "value": "cute,orange",
                      "type": "text"
                    }
                  ]
                }
              },
              "status": "OK",
              "code": 200,
