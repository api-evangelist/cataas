      },
      "item": [
        {
          "id": "7f12114b-d6b8-4d24-9c80-1d8c5e196a3a",
          "name": "CATAAS Upload a New Cat Image",
          "request": {
            "name": "CATAAS Upload a New Cat Image",
            "description": {
              "content": "Submit a new cat image to the catalog. The image is validated as a real image file before being persisted. May require moderation before appearing in `/api/cats`.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "upload"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "description": "(Required) The cat image file (JPEG, PNG, or GIF)."
                },
                {
                  "key": "tags",
                  "value": "<string>",
                  "type": "text",
                  "description": "Comma-separated list of tags to apply to the new cat."
                }
              ]
            }
          },
          "response": [
            {
              "id": "0bf87be3-0c73-43cc-9cfe-a8c527e41c3a",
              "name": "The newly created cat document",
              "originalRequest": {
                "url": {
                  "path": [
